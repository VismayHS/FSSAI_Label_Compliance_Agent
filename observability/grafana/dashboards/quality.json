    {
      "type": "table",
      "title": "Top reasons given for unsatisfactory runs",
      "description": "Reasons grouped by their lower-cased text; GET /v1/feedback/summary gives the same grouping.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT lower(trim(reason)) AS reason, count(*) AS times, max(submitted_at) AS last_seen FROM feedback WHERE NOT satisfactory AND $__timeFilter(submitted_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 15"
