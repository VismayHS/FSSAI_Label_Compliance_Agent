    {
      "type": "timeseries",
      "title": "Quality over time",
      "description": "Daily means of the live scores. A drop after a deploy or a prompt change shows up here before users report it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(scored_at, '1h'), avg(groundedness) AS groundedness, avg(faithfulness) AS faithfulness, avg(citation_resolution) AS \"citation resolution\", avg(context_relevance) AS \"context relevance\" FROM quality_scores WHERE $__timeFilter(scored_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
