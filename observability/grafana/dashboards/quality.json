            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(route, 'unknown') AS route, avg(satisfactory::int) AS \"satisfactory rate\", count(*) AS feedback FROM feedback WHERE $__timeFilter(submitted_at) GROUP BY 1 ORDER BY 1"
