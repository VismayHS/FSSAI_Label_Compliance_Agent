          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT (SELECT count(*) FROM feedback WHERE $__timeFilter(submitted_at))::float / NULLIF((SELECT count(*) FROM runs WHERE state = 'completed' AND $__timeFilter(updated_at)), 0)"
