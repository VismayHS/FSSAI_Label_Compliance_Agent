# Copy to .env and fill in. NEVER commit .env. (D4: no credentials, endpoints or model ids in the repo.)
# Each owner edits ONLY their own section below. Empty value = default / fake.

# ======================================================================
# Shared / platform: owner Vismay
# ======================================================================
LOG_LEVEL=INFO

# LLM provider: any OpenAI-compatible endpoint (free tier). Values live only in your .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
# Extra attempts after the first one, for retryable errors only (timeouts, 429, 5xx); never past RUN_MAX_WALL_S.
LLM_MAX_RETRIES=3
LLM_PRICE_PROMPT_PER_1K=0
LLM_PRICE_COMPLETION_PER_1K=0
# Optional fallback provider/model used by the degradation path
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_PRICE_PROMPT_PER_1K=0
LLM_FALLBACK_PRICE_COMPLETION_PER_1K=0
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_S=30

# Agent loop bounds (A1), read by fssai_contracts.context.RunLimits
RUN_MAX_STEPS=25
RUN_MAX_TOOL_CALLS=15
RUN_MAX_WALL_S=90
RUN_MAX_RESEARCH_ATTEMPTS=3

# How the API hands a run to a worker: inline = inside the API process (local dev, no Redis needed);
# queue = RQ queue on REDIS_URL, executed by `python -m fssai_worker` (needs a shared IMPL_RUN_STORE).
# Compose always uses queue + the Postgres run store + a Redis breaker (infra/compose/api.yml, worker.yml);
# these values are for running the API by hand.
RUN_DISPATCH=inline
INLINE_WORKERS=2
# Circuit-breaker state: memory = per process (local dev); redis = shared by every scaled worker (Compose).
BREAKER_STORE=memory
WORKER_METRICS_PORT=9100
API_MAX_REQUEST_BYTES=262144
RUN_STORE_MAX_CONNECTIONS=5

# Inside Compose these hosts are the service names. Compose builds DATABASE_URL from the POSTGRES_* values.
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://fssai:change-me-locally@postgres:5432/fssai
POSTGRES_USER=fssai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=fssai

# Host ports Compose publishes (change one if it clashes with something on your machine)
API_HOST_PORT=8000
WEB_HOST_PORT=8080
# Where the trace view links to (the Jaeger UI as the browser sees it); used only when tracing is on
JAEGER_UI_URL=http://localhost:16686

# Webhook callback (extra): a caller may send X-Callback-Url with POST /v1/runs and is notified when the run ends.
# Off while empty: comma-separated hosts the worker may call (nothing else is ever called). WEBHOOK_SECRET signs each
# notice (header X-FSSAI-Signature: sha256=<HMAC of the body>); set it in .env only.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_S=5
WEBHOOK_MAX_ATTEMPTS=3

# Fakes (packages/contracts/fssai_contracts/fakes.py)
FAKE_LLM_DELAY_S=0
FAKE_LLM_FAIL=0

# ----------------------------------------------------------------------
# Implementation switchboard (packages/contracts/fssai_contracts/registry.py)
# module:Class. Leave empty to use the fake. Examples in comments; flip when the real one is merged.
# ----------------------------------------------------------------------
IMPL_GATE=fssai_gate.gate:RequestGate                    # (Vihaan) on since PR #9
IMPL_RETRIEVER=fssai_retrieval.faiss_retriever:FaissRetriever  # (Nishkal) on since PR #2
IMPL_LLM=             # fssai_llm_gateway.client:GatewayLLMClient         (Vismay)  | dev: fssai_contracts.dev_llm:DevLLMClient
IMPL_PROMPTS=fssai_prompts.store:FilePromptStore         # (Namith) on since PR #4
IMPL_GUARDRAILS=fssai_guardrails.guardrails:Guardrails    # (Namith) on since PR #7
IMPL_CLASSIFIER=fssai_agents.classifier:LLMClassifier    # (Namith) on since PR #4
IMPL_RESEARCHER=fssai_agents.researcher:LangGraphResearcher  # (Namith) on since PR #6
IMPL_VERIFIER=fssai_verification.verifier:AgentVerifier  # (Vihaan) on since PR #9
IMPL_ROUTER=fssai_verification.router:RuleRouter         # (Vihaan) on since PR #9
IMPL_PIPELINE=fssai_agents.graph:LangGraphPipeline        # (Namith) on since PR #7
IMPL_RUN_STORE=       # fssai_run_store.postgres:PostgresRunStore         (Vismay)

# ======================================================================
# Knowledge & performance: owner Nishkal
# ======================================================================
# The one product category the corpus covers (decision 001). Anything else escalates (F7).
CORPUS_CATEGORIES=breakfast-cereals

# Retriever switch (put it in the switchboard above when you turn it on):
#   IMPL_RETRIEVER=fssai_retrieval.faiss_retriever:FaissRetriever
# Local sentence-transformers model used to embed the corpus and queries (decision 002). Default "hashing":
# an offline lexical stand-in, so a clean clone builds its index with no download and no model id in the
# repo (D4); hybrid retrieval still runs BM25 + claim hints on top. For the demo and for measured recall, set
# the small MiniLM-class model the spec suggests (§12) in your .env; its exact name is in the team's shared
# .env. Changing it re-embeds on the next `docker compose up` (the indexer runs with --reembed changed).
EMBEDDING_MODEL=hashing
# cpu, or cuda on a GPU machine
EMBEDDING_DEVICE=cpu
# Where the index lives (the indexer writes it, workers read it; a named volume in Compose).
# The model cache is HF_HOME=/data/hf-cache, set per container in Compose (not here, so local runs keep theirs).
INDEX_DIR=/data/index
# Chunks never cross a clause; a clause longer than this splits into sub-clauses (decision 002)
CHUNK_MAX_CHARS=1200
# hybrid (dense + BM25 + claim hints, default) | dense | bm25
RETRIEVAL_MODE=hybrid
# 1 = fuse data/corpus/claim_triggers.yaml hints into the ranking
RETRIEVAL_CLAIM_HINTS=1
# 0 = search in-force text only; superseded originals stay in the index for lookup
RETRIEVAL_INCLUDE_SUPERSEDED=0
# Optional cross-encoder reranker model name; empty = off
RERANKER_MODEL=
# Retrieval cache in Redis (REDIS_URL above); 0 for the with/without comparison (decision 003)
CACHE_ENABLED=1
CACHE_TTL_S=86400

# Tracing: OTLP/HTTP endpoint. In Compose: http://jaeger:4318. Empty = tracing off (no-op).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Stub LLM (apps/stub_llm). Load tests: LLM_BASE_URL=http://stub-llm:8080/v1 and LLM_MODEL=stub
STUB_LATENCY_MEAN_S=1.5
STUB_LATENCY_P95_S=4
# share of calls answered 500 / 429 (A5 demo)
STUB_FAIL_RATE=0
STUB_RATE_LIMIT_RATE=0
# 0 | 1 (answer 503) | hang (never answer in time). Also switchable at runtime: POST /admin/faults
STUB_DOWN=0
STUB_LLM_HOST_PORT=8081

# Observability stack (infra/compose/observability.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally
# Grafana's Postgres datasource and the postgres exporter: use a read-only role where you have one
GRAFANA_PG_USER=fssai
GRAFANA_PG_PASSWORD=change-me-locally
PROMETHEUS_RETENTION=7d

# ======================================================================
# Agent reasoning: owner Namith
# ======================================================================
# Switch on (put in the switchboard when merged):
#   IMPL_PROMPTS=fssai_prompts.store:FilePromptStore
#   IMPL_CLASSIFIER=fssai_agents.classifier:LLMClassifier
#   IMPL_RESEARCHER=fssai_agents.researcher:LangGraphResearcher
#   IMPL_PIPELINE=fssai_agents.graph:LangGraphPipeline
# Pin a prompt version (empty = newest). `python -m fssai_prompts list` shows what exists.
PROMPT_CLASSIFIER_VERSION=
PROMPT_RESEARCHER_VERSION=1.0.0   # baseline; 1.1.0 is the M3.2 variant (modifier checklist). Empty = newest.
PROMPT_RESEARCHER_DRAFT_VERSION=
# Researcher loop: act/tool rounds per attempt (also capped by the remaining step budget), passages per
# search, steps held back for the verifier/router/output filter, and the guard that turns a
# "% of RDA" condition into cannot_determine until a cited reference value exists (0 = off)
RESEARCHER_MAX_ITERATIONS=5
RESEARCHER_SEARCH_K=5
RESEARCHER_STEP_RESERVE=5
RESEARCHER_RDA_GUARD=1
GUARDRAIL_MAX_FIELD_CHARS=4000

# ======================================================================
# Trust & evaluation: owner Vihaan
# ======================================================================
# Switch on (put in the switchboard above; each passes its conformance check, see docs/contexts/Vihaan.md):
#   IMPL_GATE=fssai_gate.gate:RequestGate
#   IMPL_VERIFIER=fssai_verification.verifier:AgentVerifier
#   IMPL_ROUTER=fssai_verification.router:RuleRouter
#
# Gate (docs/data-contract.md). Per-client token bucket: BURST requests, refilled at PER_MIN per minute; 0 = off.
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_BURST=10
# auto = Redis (REDIS_URL) when reachable, else per-process memory | redis | memory
RATE_LIMIT_BACKEND=auto
# auto = Postgres (DATABASE_URL, table from infra/postgres/init/20-vihaan-quarantine.sql) when reachable, else memory
QUARANTINE_STORE=auto
# Same choice for POST /v1/runs/{id}/feedback (table 21-vihaan-feedback.sql)
FEEDBACK_STORE=auto
#
# Verifier (docs/decisions/202-vihaan-verifier-design.md). llm = NLI-style support check with prompt
# verifier_support | off = deterministic checks only (citations resolve, numbers re-derived)
VERIFIER_SUPPORT_CHECK=llm
# Tolerance on declared nutrient values, FSS-LD-2020 5(3)(d) (± 20 %): a declared value whose band spans a claim's
# threshold escalates instead of being decided. 0 = off.
VERIFIER_TOLERANCE_PCT=20
# clause_lookup calls per verification, to sharpen a retry hint when a citation names an unretrieved clause
VERIFIER_MAX_LOOKUPS=2
# Pin the verifier's prompt version (empty = newest)
PROMPT_VERIFIER_SUPPORT_VERSION=
#
# Eval (packages/eval/README.md). Judge: reference (offline, deterministic) | llm (our judge prompts via IMPL_LLM) |
# trulens (TruLens feedback functions; pip install -e "packages/eval[trulens]")
EVAL_JUDGE=reference
# The judge's OpenAI-compatible provider for --judge trulens; empty = the LLM_* values above. Values in .env only.
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
# Judge answers are cached here so re-scoring costs no quota (in Compose a volume; locally e.g. .cache/eval-judge)
EVAL_JUDGE_CACHE_DIR=/data/eval-cache
# Runs scored per round by `python -m fssai_eval live` and the eval-scorer service, and how often it runs (seconds)
LIVE_SCORE_SAMPLE=10
LIVE_SCORE_EVERY_S=300
# Seconds between scenarios in `fssai_eval run` against a free tier (one real run is ~8-12.5k tokens; Groq's free
# tier allows 8,000 tokens a minute). 0 = no pause, which is right for the fakes and the stub.
EVAL_PAUSE_S=0
