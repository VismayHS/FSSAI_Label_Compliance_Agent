# Copy to .env and fill in. NEVER commit .env. (D4: no credentials, endpoints or model ids in the repo.)
# Each owner edits ONLY their own section below. Empty value = default / fake.

# ======================================================================
# Shared / platform: owner Vismay
# ======================================================================
LOG_LEVEL=INFO

# LLM provider: any OpenAI-compatible endpoint (free tier). Values live only in your .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_PRICE_PROMPT_PER_1K=0
LLM_PRICE_COMPLETION_PER_1K=0
# Optional fallback provider/model used by the degradation path
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_S=30

# Agent loop bounds (A1), read by fssai_contracts.context.RunLimits
RUN_MAX_STEPS=25
RUN_MAX_TOOL_CALLS=15
RUN_MAX_WALL_S=90
RUN_MAX_RESEARCH_ATTEMPTS=3

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://fssai:fssai@postgres:5432/fssai
POSTGRES_USER=fssai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=fssai

# Fakes (contracts/fssai_contracts/fakes.py)
FAKE_LLM_DELAY_S=0
FAKE_LLM_FAIL=0

# ----------------------------------------------------------------------
# Implementation switchboard (contracts/fssai_contracts/registry.py)
# module:Class. Leave empty to use the fake. Examples in comments; flip when the real one is merged.
# ----------------------------------------------------------------------
IMPL_GATE=            # fssai_gate.gate:RequestGate                       (Vihaan)
IMPL_RETRIEVER=       # fssai_retrieval.faiss_retriever:FaissRetriever    (Nishkal)
IMPL_LLM=             # fssai_llm_gateway.client:GatewayLLMClient         (Vismay)  | dev: fssai_contracts.dev_llm:DevLLMClient
IMPL_PROMPTS=         # fssai_prompts.store:FilePromptStore               (Namith)
IMPL_GUARDRAILS=      # fssai_guardrails.guardrails:Guardrails            (Namith)
IMPL_CLASSIFIER=      # fssai_agents.classifier:LLMClassifier             (Namith)
IMPL_RESEARCHER=      # fssai_agents.researcher:LangGraphResearcher       (Namith)
IMPL_VERIFIER=        # fssai_verification.verifier:AgentVerifier         (Vihaan)
IMPL_ROUTER=          # fssai_verification.router:RuleRouter              (Vihaan)
IMPL_PIPELINE=        # fssai_agents.graph:LangGraphPipeline              (Namith)
IMPL_RUN_STORE=       # fssai_run_store.postgres:PostgresRunStore         (Vismay)

# ======================================================================
# Knowledge & performance: owner Nishkal
# ======================================================================
CORPUS_CATEGORIES=demo-category   # the one product category we support (decided in ADR 001)
EMBEDDING_MODEL=
INDEX_DIR=/data/index
CACHE_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=
STUB_LATENCY_MEAN_S=1.5
STUB_LATENCY_P95_S=4
STUB_FAIL_RATE=0
STUB_DOWN=0

# ======================================================================
# Agent reasoning: owner Namith
# ======================================================================
PROMPT_CLASSIFIER_VERSION=
PROMPT_RESEARCHER_VERSION=
GUARDRAIL_MAX_FIELD_CHARS=4000

# ======================================================================
# Trust & evaluation: owner Vihaan
# ======================================================================
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_BURST=10
EVAL_JUDGE_CACHE_DIR=/data/eval-cache
LIVE_SCORE_SAMPLE=10
